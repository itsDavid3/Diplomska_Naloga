@{
    ViewData["Title"] = "Shrani/Naloži igro";
}


<main id="game-container">
    <section id="game-topbar">
        <div class="nav">
            <a asp-area="" asp-controller="Home" asp-action="Index"><img src="/images/LOGO.png" /></a>
        </div>

        <div class="game-stats">

        </div>
    </section>


    <section id="game-main">
        <div class="SaveLoad-container">
            <section class="ExportGame">
                <h2>Izvozi shranjeno igro</h2>

                @if (!string.IsNullOrEmpty(Model.ExportData)) {
                    <div class="form-group">
                        <label for="exportData">Vaš niz za shranjevanje:</label>
                        <textarea id="exportData" readonly>@Model.ExportData</textarea>
                        <p>Ta niz vsebuje vse podatke o vaši igri. <br /> Kopirajte ga in shranite na varno mesto!</p>
                    </div>
                } else {
                    <p>Ni podatkov o igri za izvoz.</p>
                }
            </section>


            <section class="ImportGame">
                <h2>Uvozi shranjeno igro</h2>
                <form asp-controller="Game" asp-action="ImportGame" method="post">
                    <div class="form-group">
                        <label for="importData">Spodaj prilepite niz za shranjevanje, da naložite prejšnjo igro:</label>
                        <textarea id="importData" name="importData" placeholder="Prilepite niz za shranjevanje tukaj..."></textarea>
                        <p>Prepričajte se, da ste prilepili celoten niz brez dodatnih presledkov na začetku ali koncu.</p>
                    </div>

                    <div class="button-group">
                        <button type="submit">Naloži igro</button>
                    </div>
                </form>
            </section>

            <div class="button-group">
                <form asp-controller="Game" asp-action="Index" method="get">
                    <button type="submit">Nazaj k igri</button>
                </form>
            </div>
        </div>
    </section>
</main>